# RAG Platform — Environment Variables Template
# Copy to .env and fill in real values before deployment
#   cp .env.example .env

# === Required: API Keys ===
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
ALIYUN_API_KEY=sk-your-aliyun-key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# === Required: Security ===
SECRET_KEY=generate-with-openssl-rand-base64-32

# === Required: Database & Cache ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/backend_dev
REDIS_URL=redis://redis:6379/0

# === Optional: ChromaDB ===
CHROMA_URL=chroma
RAG_DOCS_DIR=/app/notes

# === Optional: Logging ===
LOG_LEVEL=INFO
LOG_JSON=true

# === Optional: OpenTelemetry ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_SERVICE_NAME=rag-api

# === Optional: Testing ===
# TESTING=false
