# 竞品雷达 — 环境变量配置
# 复制为 .env 并填写实际值:  cp .env.example .env

# === LLM（必填）===
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# LLM_CHAT_URL=                 # 可选：自定义 chat API 地址，留空则用 DEEPSEEK_BASE_URL + /v1/chat/completions

# === 数据库与缓存 ===
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/backend_dev
REDIS_URL=redis://127.0.0.1:6379/0

# === GitHub 采集（可选）===
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx           # GitHub API token，提高请求频率上限
# GITHUB_VERIFY_SSL=true                  # SSL 证书验证，内网环境可设为 false

# === 日志（可选）===
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_DIR=./logs                 # 以下 4 项有默认值，通常无需修改
# LOG_FILE=app.log
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=5
